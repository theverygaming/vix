override INT_CFLAGS += -fno-pie -ffreestanding -nostdinc -nostdlib -nostartfiles -fno-exceptions -fno-merge-constants -munaligned-access -I$(LITTLEBOOT_INCLUDEPATH)
override INT_CXXFLAGS += -fno-pie -ffreestanding -nostdinc -nostdlib -nostartfiles -fno-exceptions -fno-merge-constants -munaligned-access -I$(LITTLEBOOT_INCLUDEPATH)
override INT_LDFLAGS  +=

ifeq ($(CONFIG_ENABLE_FTRACE), y)
override INT_CFLAGS += -finstrument-functions
override INT_CXXFLAGS += -finstrument-functions
endif

ifeq ($(CONFIG_ENABLE_STACKPROTECTOR), y)
override INT_CFLAGS += -fstack-protector-strong
override INT_CXXFLAGS += -fstack-protector-strong
else
override INT_CFLAGS += -fno-stack-protector
override INT_CXXFLAGS += -fno-stack-protector
endif
