obj-$(CONFIG_ENABLE_STACKPROTECTOR) += stackprotector.o

obj-y += generic/cpu.o generic/devices.o
obj-y += archinit.o sched_s.o sched.o io.o

obj-$(CONFIG_XTENSA_PLATFORM_ESP8266) += vectors.o vectors_s.o

ifneq ($(strip $(CONFIG_XTENSA_VARIANT_NAME)),)
# FIXME: HACK: we use the shell to unquote the config option, the quoted config option breaks the path for makefiles. We'd probably want to use include/config/auto.conf for the makefiles, instead of .config, but that isn't easy to implement due to include order (auto.conf generated by syncconfig, runs after the include -> build broken)..
obj-d += variants/$(shell echo $(CONFIG_XTENSA_VARIANT_NAME))
endif

ifneq ($(strip $(CONFIG_XTENSA_PLATFORM_NAME)),)
# FIXME: HACK: we use the shell to unquote the config option, the quoted config option breaks the path for makefiles. We'd probably want to use include/config/auto.conf for the makefiles, instead of .config, but that isn't easy to implement due to include order (auto.conf generated by syncconfig, runs after the include -> build broken)..
obj-d += platforms/$(shell echo $(CONFIG_XTENSA_PLATFORM_NAME))
endif
